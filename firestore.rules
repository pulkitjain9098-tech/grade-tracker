rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCollegeUser() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@lnmiit[.]ac[.]in$') &&
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == '25ucs113@lnmiit.ac.in' && request.auth.token.email_verified == true;
    }

    function okGrade(g) {
      return !(g in request.resource.data) ||
             (request.resource.data[g] is number &&
              request.resource.data[g] >= 0 &&
              request.resource.data[g] <= 100);
    }

    function notRaised(g) {
      return !(g in resource.data) ||
             (g in request.resource.data &&
              request.resource.data[g] <= resource.data[g]);
    }

    function validSummary() {
      return request.resource.data.keys().hasOnly(['A','AB','B','BC','C','CD','D','F','updatedAt'])
        && okGrade('A') && okGrade('AB') && okGrade('B') && okGrade('BC')
        && okGrade('C') && okGrade('CD') && okGrade('D') && okGrade('F');
    }

    function notRaisedAny() {
      return notRaised('A') && notRaised('AB') && notRaised('B') && notRaised('BC')
        && notRaised('C') && notRaised('CD') && notRaised('D') && notRaised('F');
    }

    // Individual entries: write-only from the app. Only you can read them (Firebase console).
    match /submissions/{docId} {
      allow read: if isAdmin();
      allow create, update: if isCollegeUser()
        && request.resource.data.uid == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.subject
        && request.resource.data.marks is number
        && request.resource.data.marks >= 0
        && request.resource.data.marks <= 100
        && request.resource.data.grade is string;
      allow delete: if isAdmin();
    }

    // One summary doc per subject: lowest marks seen for each grade.
    match /summaries/{subject} {
      allow read: if isCollegeUser();
      allow create: if isCollegeUser() && validSummary();
      allow write: if isAdmin();
      allow update: if isCollegeUser() && validSummary() && notRaisedAny();
      allow delete: if isAdmin();
    }
  }
}
